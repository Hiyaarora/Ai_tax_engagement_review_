# Copy to backend/.env and fill in. Non-secret values only.
# Authentication to Azure uses DefaultAzureCredential (run `az login` locally) - there are NO API keys here.

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DATA_DIR=../data
DATABASE_URL=sqlite:///../data/fd_tax_review.db

# --- Microsoft Foundry (project already exists) ---
# Foundry portal -> project -> Overview -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=
# Foundry portal -> Agents -> FDprojectAgent -> ID (starts with asst_)
FOUNDRY_AGENT_ID=
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search (provisioned in Milestone 2, Basic tier) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=fd-evidence

# --- Azure AI Document Intelligence (provisioned in Milestone 2) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

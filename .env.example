# Copy to backend/.env and fill in. Non-secret values only - endpoints, names and IDs.
# Authentication to Azure uses DefaultAzureCredential (run `az login` locally) - there are NO API keys here.
# Never commit backend/.env (it is gitignored).

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DATA_DIR=../data
DATABASE_URL=sqlite:///../data/fd_tax_review.db

# --- Microsoft Foundry (project + model deployments; East US 2) ---
# Foundry portal -> project -> Overview -> "Project endpoint"
# Shape: https://<resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of the hosted prompt agent in the project (Foundry portal -> Agents). scripts/sync_agent.py
# pushes instructions, tools and the output schema to it as a new version.
FOUNDRY_AGENT_NAME=FDprojectAgent
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search (Basic tier; RBAC auth, no admin key) ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=fd-evidence

# --- Azure AI Document Intelligence (S0; F0 would analyze only the first 2 pages per document) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/

# --- Client budgets (seconds) - a stalled Azure call fails fast instead of hanging a review ---
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
AZURE_TIMEOUT_SECONDS=60

# --- Observability (Milestone 5) ---
# Traces: leave both empty to trace locally without exporting. To see runs in the Foundry
# "Tracing" tab, attach an Application Insights resource to the project (Foundry -> project ->
# Tracing) and set OTEL_USE_FOUNDRY_APP_INSIGHTS=true, or paste the connection string directly.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_USE_FOUNDRY_APP_INSIGHTS=false
# Print spans to stdout while developing.
OTEL_CONSOLE_EXPORT=false
